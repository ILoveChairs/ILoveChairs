{
  "spells": [
    {
      "enName": "Acid Splash",
      "esName": "",
      "enDesc": "You create an acidic bubble at a point within range, where it explodes in a 5-foot-radius Sphere. Each creature in that Sphere must succeed on a Dexterity saving throw or take 1d6 Acid damage. Damage increases by 1d6 when you reach levels 5 (2d6), 11 (3d6), and 17 (4d6).",
      "esDesc": "",
      "level": 0,
      "school": "evocation",
      "spellLists": ["sorcerer", "wizard"],
      "castingTime": "action",
      "range": "60 ft",
      "components": ["v", "s"],
      "duration": "instantaneous",
      "special": []
    },
    {
      "enName": "Aid",
      "esName": "",
      "enDesc": "Choose up to three creatures within range. Each target's Hit Point maximum and current Hit Points increase by 5 for the duration. Each target's Hit Points increase by 5 for each spell slot level above 2.",
      "esDesc": "",
      "level": 2,
      "school": "abjuration",
      "spellLists": ["bard", "cleric", "druid", "paladin", "ranger"],
      "castingTime": "action",
      "range": "30 ft",
      "components": ["v", "s", "m (a strip of white cloth)"],
      "duration": "8 hours",
      "special": []
    },
    {
      "enName": "Alarm",
      "esName": "",
      "enDesc": "You set an alarm against intrusion. Choose a door, a window, or an area within range that is no larger than a 20-foot Cube. Until the spell ends, an alarm alerts you whenever a creature touches or enters the warded area. When you cast the spell, you can designate creature that won't set off the alarm. You also choose wherer the alarm is audible or mental. Audible Alarm: The alarm produces the sound of a handbell for 10 seconds within 60 feet of the warded area. Mental Alarm: You are alerted by a mental ping if you are within 1 mile of the warded area. This ping awakens you if you're aslpee.",
      "esDesc": "",
      "level": 1,
      "school": "abjuration",
      "spellLists": ["ranger", "wizard"],
      "castingTime": "1 minute",
      "range": "30 ft",
      "components": ["v", "s", "m (a bell and silver wire)"],
      "duration": "8 hours",
      "special": ["ritual (optional)"]
    },
    {
      "enName": "Alter Self",
      "esName": "",
      "enDesc": "You alter your physical form. Choose one of the following options. Its effects last for the duration, during which you can take a Magic action to replace the option you choose with a different one.",
      "esDesc": "",
      "level": 2,
      "school": "transmutation",
      "spellLists": ["sorcerer", "wizard"],
      "castingTime": "action",
      "range": "self",
      "components": ["v", "s"],
      "duration": "1 hour",
      "special": ["concentration"]
    },
